{
  "expo": {
    "name": "VTM CRM",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vernontm.crm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Lets you send photos and videos from your library to customers and teammates.",
        "NSMicrophoneUsageDescription": "Lets you record a voice note to send in a conversation, and dictate a message instead of typing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vernontm.crm"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you send photos and videos from your library to customers and teammates."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lets you record a voice note to send in a conversation, and dictate a message instead of typing."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "7906617b-cc7c-418e-bc85-e919d47b05fb"
      }
    },
    "owner": "vernontm"
  }
}
